{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "exe-auth",
    "Audience": "exe-api",
    "Key": ""
  },
  "ReverseProxy": {
    "Routes": {
      "auth-public": {
        "ClusterId": "auth",
        "Order": 1,
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "auth-users": {
        "ClusterId": "auth",
        "Order": 1,
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/users/{**catch-all}" }
      },
      "auth-roles": {
        "ClusterId": "auth",
        "Order": 1,
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/roles/{**catch-all}" }
      },
      "team": {
        "ClusterId": "team",
        "Order": 100,
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/{**catch-all}" }
      }
    },
    "Clusters": {
      "auth": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5101/" }
        }
      },
      "team": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5102/" }
        }
      }
    }
  }
}
