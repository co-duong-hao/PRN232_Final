{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "exe-auth",
    "Audience": "exe-api",
    "Key": ""
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "exe-team:"
  },
  "Matching": {
    "Address": "http://localhost:5103"
  },
  "Room": {
    "LockThreshold": 3
  },
  "Jobs": {
    "CourseCloseIntervalSeconds": 60,
    "ReminderDaysBeforeDeadline": 3
  },
  "Seed": {
    "Enabled": true
  },
  "Kafka": {
    "BootstrapServers": "localhost:9094",
    "Topic": "exe.events"
  },
  "Cache": {
    "GroupTypeMinutes": 10,
    "CourseStatsSeconds": 30
  }
}
