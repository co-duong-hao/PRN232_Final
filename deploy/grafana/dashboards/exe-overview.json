{
  "uid": "exe-overview",
  "title": "EXE Team Matching",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Dịch vụ",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(up{job=\"exe-services\"}, service)",
        "definition": "label_values(up{job=\"exe-services\"}, service)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 28,
      "type": "row",
      "title": "Container",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 29,
      "type": "stat",
      "title": "Trạng thái container",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Mỗi ô là một container. UP: trả lời Prometheus trong 5 giây gần nhất. Service .NET, Grafana, Prometheus được kiểm tra qua /metrics; SQL Server, Redis, Kafka, Mailpit, web được blackbox exporter kiểm tra kết nối. DOWN quá 30 giây thì Grafana gửi email cảnh báo tới Mailpit.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 17,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (service) (exe:service_up)",
          "instant": true,
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "noValue": "DOWN",
          "displayName": "${__field.labels.service}"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 30,
      "type": "alertlist",
      "title": "Cảnh báo đang bật",
      "datasource": null,
      "description": "Các cảnh báo \"Container không phản hồi\" đang ở trạng thái Firing hoặc Pending. Trống nghĩa là mọi container đều ổn.",
      "gridPos": {
        "x": 17,
        "y": 1,
        "w": 7,
        "h": 9
      },
      "options": {
        "viewMode": "list",
        "groupMode": "default",
        "groupBy": [],
        "maxItems": 20,
        "sortOrder": 1,
        "dashboardAlerts": false,
        "alertName": "",
        "alertInstanceLabelFilter": "",
        "stateFilter": {
          "firing": true,
          "pending": true,
          "noData": true,
          "normal": false,
          "error": true
        },
        "showInstances": true
      }
    },
    {
