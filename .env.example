# Copy to .env (git-ignored) before running `docker compose up`.
# These are local development values only. Change them for any shared environment.

# SQL Server requires accepting Microsoft's licence terms. Set to Y if you accept them:
# https://go.microsoft.com/fwlink/?linkid=857698
MSSQL_ACCEPT_EULA=

MSSQL_SA_PASSWORD=Local_Dev_Pass_2026!

# HMAC key for access tokens, at least 32 bytes. Shared by gateway, auth-service and team-service.
JWT_KEY=local-dev-only-jwt-signing-key-0123456789abcdef

# Password given to every seeded account (admin, staff, sample students).
SEED_DEFAULT_PASSWORD=Exe@12345
